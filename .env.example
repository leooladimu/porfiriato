# Copy to .env (local) and set the same names in Vercel. Never commit real values.

# Resend (contact form email)
RESEND_API_KEY=
EMAIL_TO=
EMAIL_FROM=

# Contact form spam protection
# Cloudflare Turnstile: create a site at https://dash.cloudflare.com/ -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Random secret that signs the form's render-time token, e.g. `openssl rand -hex 32`
FORM_TOKEN_SECRET=

# Upstash Redis (rate limiting). The Vercel integration sets KV_REST_API_URL and
# KV_REST_API_TOKEN automatically; for a manual setup use these names instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
